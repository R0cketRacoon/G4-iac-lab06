#Este archivo sólo es una plantilla de lo que debe contener el archivo .env. El verdadero archivo .env se encuentra oculto y no debe subirse a GitHub, ya que contiene información sensible.

# --- Cuenta de AWS -----------------------------------------------------------
# ID de 12 dígitos. Terraform se niega a desplegar en cualquier otra cuenta.
ID_CUENTA_AWS=<123456789012>

# Región del diagrama.
REGION_AWS=us-east-1

# Perfil de AWS CLI creado con "aws configure sso". Déjalo vacío solo en
# GitHub Actions, donde las credenciales llegan por OIDC.
PERFIL_AWS=image-processor

# --- Proyecto ----------------------------------------------------------------
# Prefijo de todos los recursos: image-processor-dev-..., -qa-..., -prod-...
NOMBRE_PROYECTO=image-processor

# Bucket del estado de Terraform. Vacío = se usa el nombre por defecto:
# <NOMBRE_PROYECTO>-tfstate-<ID_CUENTA_AWS>
BUCKET_ESTADO=

# --- GitHub ------------------------------------------------------------------
# Solo los workflows de este repositorio podrán entrar a AWS (OIDC).
ORGANIZACION_GITHUB=<tu-usuario-u-organizacion>
REPOSITORIO_GITHUB=image-processor-iac

# false si la cuenta ya tiene el proveedor OIDC de GitHub creado.
CREAR_PROVEEDOR_OIDC=true

# --- Alertas -----------------------------------------------------------------
# Correo que recibe las alarmas de la DLQ. Vacío = sin suscripción.
CORREO_ALERTAS=
